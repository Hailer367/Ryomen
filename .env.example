# ── Ryomen configuration ────────────────────────────────────────────────────
# Copy this file to `.env.local` and adjust as needed.

# CoinGecko API base URL. The free public API works out of the box.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Optional: CoinGecko Pro / Demo API key. When set, requests are sent with the
# `x-cg-demo-api-key` header and a higher rate limit is assumed.
# COINGECKO_API_KEY=

# CoinGecko request budget. The free tier hard-rate-limits (measured: 3 rapid
# requests succeed, the 4th returns 429). We spend a small fixed budget rather
# than discovering the limit at runtime. `BURST` requests may go immediately;
# the rest refill at REQUESTS_PER_MINUTE. Raise this only with a Pro/Demo key.
COINGECKO_REQUESTS_PER_MINUTE=5

# Where the SQLite database lives (relative paths resolve from the repo root).
RYOMEN_DB_PATH=data/ryomen.db

# How long cached OHLC/price data stays fresh, in seconds.
RYOMEN_CACHE_TTL_SECONDS=300

# How long stale data may be served while a background refresh runs.
RYOMEN_STALE_TTL_SECONDS=3600

# Paper trading defaults.
RYOMEN_STARTING_CASH=10000
RYOMEN_FEE_BPS=10
RYOMEN_SLIPPAGE_BPS=5
